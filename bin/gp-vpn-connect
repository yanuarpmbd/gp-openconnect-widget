#!/bin/bash
# Connects to GlobalProtect via openconnect.
#
# Usage: gp-vpn-connect <gateway> <username> <password>
#
# ---------------------------------------------------------------------------
# Design
# ---------------------------------------------------------------------------
#
# The requirement that shapes everything: one connect attempt must produce
# EXACTLY ONE approval request on the user's phone, and if it gives up it must
# leave NOTHING alive that keeps talking to the gateway.
#
# 1. NO --background. `openconnect --background` forks a child once it thinks
#    authentication is done; that child owns the tunnel and retries by itself
#    (--reconnect-timeout defaults to 300s). If such an attempt is abandoned,
#    killing the process we started leaves the fork alive as an orphaned root
#    process still POSTing /global-protect/getconfig.esp — and every POST is
#    another approval push. That is exactly the reported "it keeps sending
#    requests after it timed out". Run in the FOREGROUND, openconnect is a
#    single non-forking process: the one thing started is the one thing killed.
#
# 2. The 60s budget covers the AUTHENTICATION WAIT ONLY, not the tunnel's life.
#    Inside the privileged session a watcher loop polls for the tun interface:
#      - tunnel appears  -> watcher exits, openconnect keeps running (it IS the
#        VPN), and the session stays alive as long as the tunnel does;
#      - budget expires  -> watcher kills openconnect, so the session ends.
#    Wrapping openconnect in `timeout` instead would tear down a WORKING VPN
#    60 seconds after it came up.
#
# 3. Exactly ONE credential line. Each credential submission is its own POST to
#    getconfig.esp and each POST fires one approval push — measured on this
#    gateway: queued answers get consumed by its re-prompt loop (20 queued =
#    20 POSTs, 2 = 2). One line = one request. The line travels over a FIFO
#    that is held open for the whole window, because against a closed stdin
#    openconnect cannot wait out the approval.
#
# 4. ONE pkexec session does the launching AND the killing. A second
#    `pkexec pkill` to enforce the timeout would request its own polkit
#    authorization; while the user is mid-approval on their phone nothing
#    answers that prompt, so the kill call hangs and the timeout never fires.
#
# 5. Success is judged by a tun/ppp interface actually carrying an IPv4
#    address: no pid-file is written in this setup, and a live process is not
#    proof of a tunnel.
#
# Outcome: 0 connected, 1 failed, 4 rejected, 5 unreachable, 6 timed out.
set -uo pipefail

GATEWAY="${1:-}"
USERNAME="${2:-}"
PW="${3:-}"

if [[ -z "$GATEWAY" || -z "$USERNAME" ]]; then
  echo "Usage: gp-vpn-connect <gateway> <username> [password]"
  exit 2
fi

# If password is not provided as third argument, read from stdin with 5s timeout
if [[ -z "$PW" ]]; then
  if ! IFS= read -r -t 5 PW && [[ -z "$PW" ]]; then
    echo "Password is required on standard input or as third argument."
    exit 2
  fi
fi

if [[ -z "$PW" ]]; then
  echo "Password cannot be empty."
  exit 2
fi

if pgrep -x openconnect >/dev/null 2>&1; then
  echo "An openconnect session is already running."
  exit 3
fi

AUTH_TIMEOUT_SECS=60
LOG="/tmp/gp-vpn-last-attempt.log"
: > "$LOG"

WORKDIR="$(mktemp -d)"
chmod 700 "$WORKDIR"
ENV_FILE="$WORKDIR/env.sh"
PW_FIFO="$WORKDIR/pw.fifo"
STARTED_MARKER="$WORKDIR/started"
: > "$ENV_FILE"
mkfifo "$PW_FIFO"
chmod 600 "$ENV_FILE" "$PW_FIFO"

cleanup() {
  # Terminate all background child jobs started by this script (e.g. FIFO writer)
  # so that no lingering process holds open file descriptors or keeps QProcess waiting.
  local jobs_list
  jobs_list="$(jobs -p 2>/dev/null || true)"
  if [[ -n "$jobs_list" ]]; then
    kill $jobs_list 2>/dev/null || true
  fi
  rm -rf "$WORKDIR"
}
trap cleanup EXIT

# Gateway and user go into a file rather than a command string: no quoting can
# break, and no credential appears in any process's argv. Root can read it.
printf 'GP_USER=%q\nGP_GW=%q\n' "$USERNAME" "$GATEWAY" > "$ENV_FILE"

tun_up() {
  ip -o -4 addr show 2>/dev/null | awk '$2 ~ /^(tun|ppp)[0-9]+$/ {print $2}' | grep -q .
}

# One credential line, then the FIFO is held open for the whole window so
# openconnect can wait on the approval instead of hitting EOF.
{
  printf '%s\n' "$PW"
  sleep $((AUTH_TIMEOUT_SECS + 40))
} > "$PW_FIFO" &
unset PW

echo "Connecting to $GATEWAY as $USERNAME ..."

# The privileged session: start openconnect, watch for the tunnel, and only
# kill it if the budget runs out. The watcher runs INSIDE this same session, so
# no second polkit authorization is ever needed to enforce the timeout.
#
# The credential FIFO is opened by path INSIDE the root session ($3) rather
# than inherited as stdin from the caller: a backgrounded `pkexec` does not
# reliably hand the redirected stdin through to openconnect (it fails with
# "fgets (stdin): No such file or directory" and aborts before the first POST).
pkexec sh -c '
  . "$1"
  BUDGET="$2"
  FIFO="$3"
  STARTED="$4"

  touch "$STARTED" 2>/dev/null || true

  tun_up() {
    ip -o -4 addr show 2>/dev/null | awk "\$2 ~ /^(tun|ppp)[0-9]+$/ {print \$2}" | grep -q .
  }

  # Line-buffer openconnect output. openconnect uses block buffering when
  # stdout is redirected to a file, which can cause log messages to be delayed.
  # stdbuf uses LD_PRELOAD and execs in place, ensuring prompt log writes while
  # OC_PID still directly refers to openconnect so signals land accurately.
  if command -v stdbuf >/dev/null 2>&1; then
    stdbuf -oL -eL openconnect \
      --protocol=gp \
      --user="$GP_USER" \
      --passwd-on-stdin \
      "$GP_GW" < "$FIFO" &
  else
    openconnect \
      --protocol=gp \
      --user="$GP_USER" \
      --passwd-on-stdin \
      "$GP_GW" < "$FIFO" &
  fi
  OC_PID=$!

  # Watcher: after the budget, kill only if no tunnel came up. Runs in the
  # background so the session itself keeps waiting on openconnect.
  (
    i=0
    while [[ $i -lt "$BUDGET" ]]; do
      sleep 1
      if tun_up; then
        exit 0
      fi
      i=$((i + 1))
    done
    # Kill with SIGKILL, NOT SIGTERM. This is deliberate and it is the fix for
    # the "it still sends a request right at the end" symptom.
    kill -KILL "$OC_PID" 2>/dev/null || true
    # Forcibly close and send TCP RST to the gateway so it does not linger in FIN-WAIT-1
    # or keep waiting for authentication completion on the server side.
    ss -K dst "$GP_GW" 2>/dev/null || true
  ) &
  WATCHER=$!

  # Session lifetime == tunnel lifetime. If the watcher killed openconnect on
  # expiry this returns immediately; if the tunnel came up it returns when the
  # VPN ends, which is exactly right.
  wait "$OC_PID"
  OC_EXIT=$?

  # Do not leave the watcher behind once openconnect is gone.
  kill "$WATCHER" 2>/dev/null || true
  wait "$WATCHER" 2>/dev/null

  exit "$OC_EXIT"
' sh "$ENV_FILE" "$AUTH_TIMEOUT_SECS" "$PW_FIFO" "$STARTED_MARKER" > "$LOG" 2>&1 &
CONNECT_PID=$!

# Wait for Polkit authorization to be confirmed and the root session to start.
# This prevents polkit prompt delay from eating into the authentication budget.
POLKIT_WAIT=0
POLKIT_TIMEOUT=30
while [[ ! -f "$STARTED_MARKER" && $POLKIT_WAIT -lt $POLKIT_TIMEOUT ]]; do
  sleep 1
  POLKIT_WAIT=$((POLKIT_WAIT + 1))
  if ! kill -0 "$CONNECT_PID" 2>/dev/null; then
    break
  fi
done

if [[ ! -f "$STARTED_MARKER" ]]; then
  echo "Authorisation was not granted in time. Press Connect and confirm the password prompt."
  exit 7
fi

CONNECTED=0
WAITED=0
while [[ $WAITED -lt $AUTH_TIMEOUT_SECS ]]; do
  sleep 1
  WAITED=$((WAITED + 1))
  if tun_up; then
    CONNECTED=1
    break
  fi
  # Break early if openconnect and pkexec have terminated
  if ! kill -0 "$CONNECT_PID" 2>/dev/null && ! pgrep -x openconnect >/dev/null 2>&1; then
    break
  fi
done

if [[ $CONNECTED -eq 1 ]]; then
  echo "Connected."
  exit 0
fi

# Out of time. Wait for the root session to finish its teardown.
if kill -0 "$CONNECT_PID" 2>/dev/null; then
  kill -KILL "$CONNECT_PID" 2>/dev/null || true
fi
wait "$CONNECT_PID" 2>/dev/null
CONNECT_EXIT=$?

if pgrep -x openconnect >/dev/null 2>&1; then
  echo "Authentication timed out waiting for approval."
  echo "A leftover openconnect process is still running; disconnect it before retrying."
  exit 6
fi

# A rejected credential is checked BEFORE the timeout verdict: a wrong password
# would otherwise sit out the whole budget and report "timed out", which reads
# as broken waiting logic instead of the real problem.
#
# These patterns stay narrow on purpose. A bare `empty` was in this list and
# had to go: openconnect logs "Unexpected empty response body from server"
# during the ordinary 512 exchange, so it matched healthy attempts as well.
if grep -qiE 'auth-failed|Login failed|authentication failed|Invalid username|Invalid password|Credentials were rejected' "$LOG"; then
  echo "Login rejected: wrong username or password."
  exit 4
fi

if [[ $CONNECT_EXIT -eq 143 || $CONNECT_EXIT -eq 137 ]]; then
  echo "Authentication timed out waiting for approval."
  exit 6
fi

# No tunnel and openconnect gone on its own: it never got past this gateway's
# 512 re-prompt loop within the budget, which for this gateway means the
# approval request went unanswered.
if ! grep -qiE 'getaddrinfo failed|Failed to open HTTPS|Connection refused' "$LOG"; then
  if grep -qiE 'Enter login credentials|512' "$LOG"; then
    echo "Authentication timed out waiting for approval."
    exit 6
  fi
fi

if grep -qiE 'getaddrinfo failed|Failed to open HTTPS|Connection refused|Error in the pull function' "$LOG"; then
  echo "Gateway unreachable: $GATEWAY"
  exit 5
fi

echo "Connection failed."
grep -iE 'auth|fail|error|credentials|login|512|SSL|certificate' "$LOG" | tail -6
exit 1
