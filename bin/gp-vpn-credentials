#!/bin/bash
# Stores or retrieves GlobalProtect credentials in the desktop keyring.
#
# Usage:
#   gp-vpn-credentials get-user     <gateway>
#   gp-vpn-credentials get-password <gateway>
#   gp-vpn-credentials save-password <gateway> <username> <password>
#   gp-vpn-credentials clear        <gateway>
#
# The password is passed as an argument (not stdin) on purpose: the QML
# `Process` that invokes this never closes the child's stdin, so anything
# reading stdin would block forever waiting for an EOF.
set -uo pipefail

ACTION="${1:-}"
GATEWAY="${2:-}"
USERNAME="${3:-}"
PASSWORD="${4:-}"

ATTR=(service omarchy-globalprotect gateway "$GATEWAY")

case "$ACTION" in
  get-user)
    # Only the username half of the record; the password entry is separate.
    secret-tool lookup "${ATTR[@]}" field username 2>/dev/null || true
    ;;
  get-password)
    secret-tool lookup "${ATTR[@]}" field password 2>/dev/null || true
    ;;
  save-password)
    if [[ -z "$USERNAME" || -z "$PASSWORD" ]]; then
      echo "Usage: gp-vpn-credentials save-password <gateway> <username> <password>" >&2
      exit 2
    fi
    # Clear any previous record so repeated saves don't accumulate items.
    secret-tool clear "${ATTR[@]}" field username 2>/dev/null || true
    secret-tool clear "${ATTR[@]}" field password 2>/dev/null || true
    # secret-tool reads the secret from stdin for `store`.
    printf '%s' "$USERNAME" | secret-tool store \
      --label="GlobalProtect username ($GATEWAY)" \
      "${ATTR[@]}" field username >/dev/null 2>&1 || exit 1
    printf '%s' "$PASSWORD" | secret-tool store \
      --label="GlobalProtect password ($GATEWAY)" \
      "${ATTR[@]}" field password >/dev/null 2>&1 || exit 1
    echo "Saved."
    ;;
  clear)
    secret-tool clear "${ATTR[@]}" field username 2>/dev/null || true
    secret-tool clear "${ATTR[@]}" field password 2>/dev/null || true
    ;;
  *)
    echo "Usage: gp-vpn-credentials {get-user|get-password|save-password|clear} <gateway> [username] [password]" >&2
    exit 2
    ;;
esac
