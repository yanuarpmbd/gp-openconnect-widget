#!/bin/bash
# Stores or retrieves GlobalProtect credentials in the desktop keyring.
set -euo pipefail

ACTION="${1:-}"
GATEWAY="${2:-}"
USERNAME="${3:-}"

if [[ -z "$GATEWAY" ]]; then
  echo "Gateway is required." >&2
  exit 2
fi

case "$ACTION" in
  get-user)
    secret-tool lookup service omarchy-globalprotect gateway "$GATEWAY" field username 2>/dev/null || true
    ;;
  get-password)
    secret-tool lookup service omarchy-globalprotect gateway "$GATEWAY" field password 2>/dev/null || true
    ;;
  save)
    if [[ -z "$USERNAME" ]]; then exit 2; fi
    # The password is read from stdin and never appears in argv.
    secret-tool store --label="GlobalProtect ($GATEWAY)" \
      service omarchy-globalprotect gateway "$GATEWAY" field username "$USERNAME" field password
    ;;
  clear)
    secret-tool clear service omarchy-globalprotect gateway "$GATEWAY" 2>/dev/null || true
    ;;
  *)
    echo "Usage: gp-vpn-credentials {get-user|get-password|save|clear} <gateway> [username]" >&2
    exit 2
    ;;
esac
