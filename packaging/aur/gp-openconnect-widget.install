post_install() {
  cat << 'MSG'

======================================================================
GP OpenConnect Widget for Omarchy has been installed!

1. Enable the widget on your Omarchy top bar:
   omarchy plugin enable bol.gpvpn --section right
   omarchy restart shell

2. Passwordless Polkit rule installed:
   /usr/share/polkit-1/rules.d/50-openconnect.rules
   Ensure your user is in the 'wheel' group:
   sudo usermod -aG wheel $USER
======================================================================

MSG
}

post_upgrade() {
  post_install
}

post_remove() {
  echo ">>> Disabling bol.gpvpn plugin from omarchy shell..."
  omarchy plugin disable bol.gpvpn 2>/dev/null || true
  omarchy restart shell 2>/dev/null || true
}
