# Maintainer: yanuarpmbd <cambridge.pambudi@gmail.com>
pkgname=gp-openconnect-widget-git
_pkgname=gp-openconnect-widget
pkgver=1.1.0.r5.g0cee1a0
pkgrel=1
pkgdesc="GlobalProtect VPN bar widget and connection scripts for Omarchy"
arch=('any')
url="https://github.com/yanuarpmbd/omarchy-gp-vpn-widget"
license=('MIT')
depends=(
  'omarchy'
  'openconnect'
  'libsecret'
  'iproute2'
  'procps-ng'
  'curl'
  'jq'
)
makedepends=('git')
provides=('gp-openconnect-widget' 'omarchy-gp-vpn-widget')
conflicts=('gp-openconnect-widget' 'omarchy-gp-vpn-widget')
source=("$_pkgname::git+https://github.com/yanuarpmbd/omarchy-gp-vpn-widget.git")
sha256sums=('SKIP')
install=gp-openconnect-widget.install

pkgver() {
  cd "$_pkgname"
  printf "1.1.0.r%s.g%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

package() {
  cd "$_pkgname"

  # 1. Install CLI tools to /usr/bin
  install -dm755 "$pkgdir/usr/bin"
  install -m755 bin/gp-vpn-* "$pkgdir/usr/bin/"

  # 2. Install plugin to /usr/share/omarchy/shell/plugins/bol.gpvpn
  install -dm755 "$pkgdir/usr/share/omarchy/shell/plugins/bol.gpvpn"
  install -m644 plugin/manifest.json "$pkgdir/usr/share/omarchy/shell/plugins/bol.gpvpn/"
  install -m644 plugin/Widget.qml "$pkgdir/usr/share/omarchy/shell/plugins/bol.gpvpn/"

  # 3. Install polkit rule
  install -dm755 "$pkgdir/usr/share/polkit-1/rules.d"
  install -m644 config/50-openconnect.rules.example "$pkgdir/usr/share/polkit-1/rules.d/50-openconnect.rules"

  # 4. Install license and readme
  install -dm755 "$pkgdir/usr/share/licenses/$pkgname"
  install -m644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/" 2>/dev/null || true
  install -dm755 "$pkgdir/usr/share/doc/$pkgname"
  install -m644 README.md "$pkgdir/usr/share/doc/$pkgname/"
}
