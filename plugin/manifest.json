{
  "schemaVersion": 1,
  "id": "bol.gpvpn",
  "name": "GlobalProtect VPN",
  "version": "1.1.0",
  "author": "bol",
  "license": "MIT",
  "description": "Connect/disconnect GlobalProtect VPN via openconnect from the top bar",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "Widget.qml"
  },
  "barWidget": {
    "displayName": "GlobalProtect VPN",
    "description": "Connect/disconnect GlobalProtect VPN via openconnect",
    "category": "Network",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "gpGateway": ""
    },
    "schema": [
      {
        "key": "gpGateway",
        "type": "string",
        "label": "VPN Gateway",
        "description": "GlobalProtect gateway address, e.g. vpn.perusahaan.co.id",
        "defaultValue": ""
      }
    ]
  }
}
